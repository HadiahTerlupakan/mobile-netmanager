{
  "expo": {
    "name": "RADPRO",
    "slug": "netmanager",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "netmanager",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000,
      "codeSigningCertificate": "./assets/expo-updates/code-signing-certificate.pem",
      "codeSigningMetadata": {
        "keyid": "v1",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netmanager.mobile",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ],
        "NSFaceIDUsageDescription": "Gunakan Face ID untuk login dengan cepat dan aman"
      }
    },
    "android": {
      "package": "com.netmanager.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0a46aa",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "googleServicesFile": "./google-services.json",
      "config": {}
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location for attendance tracking.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "extraMavenRepos": [
              "https://www.jitpack.io"
            ],
            "gradleProperties": [
              {
                "key": "org.gradle.jvmargs",
                "value": "-Xmx4096m -XX:MaxMetaspaceSize=1024m"
              }
            ]
          },
          "ios": {
            "deploymentTarget": "15.5",
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/app/app.plugin.js",
      "@react-native-firebase/messaging/app.plugin.js",
      "./plugins/withNetworkSecurity",
      "./plugins/withNotifeeRepo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0e8762f0-6c54-4bc5-82f2-18aa3f8e765a"
      },
      "router": {},
      "versionCode": 2
    },
    "owner": "rohadimrajas-organization"
  }
}
