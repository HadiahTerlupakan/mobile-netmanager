rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.role == "SUPER_ADMIN"
      );
    }

    // Token pelanggan (portal web dan aplikasi) membawa role "CUSTOMER" dan
    // hanya boleh membaca kanalnya sendiri, users/<uid>/events: di sanalah
    // pengumuman, balasan, dan pesan tiket pelanggan dikirim. Token pelanggan
    // lama dari rute token mobile membawa tenantId dan accessEmployeePanel;
    // syarat ini menutup jalur yang dibuka klaim itu, berapa lama pun token
    // lama masih beredar.
    function isCustomer() {
      return isSignedIn() && request.auth.token.role == "CUSTOMER";
    }

    function canAccessAdminPanel() {
      return isSignedIn() && !isCustomer() && (
        isSuperAdmin() ||
        request.auth.token.accessAdminPanel == true ||
        (
          request.auth.token.roles is list &&
          request.auth.token.roles.hasAny(['ADMIN', 'MANAGER', 'OPERATOR', 'NOC', 'FINANCE'])
        )
      );
    }

    function isInTenant(tenantId) {
      return isSignedIn() && request.auth.token.tenantId == tenantId;
    }

    // Event collections — client read-only, write hanya via Admin SDK
    // (Admin SDK bypass rules; explicit `allow write: if false` mencegah
    // client menulis langsung kalau ID ditebak).

    match /users/{userId}/events/{eventId} {
      allow read: if isSuperAdmin() || request.auth.uid == userId;
      allow write: if false;
    }

    // Kanal `location:<tenantId>` membawa jejak posisi karyawan; tanpa syarat
    // tenant, admin tenant mana pun bisa mendengarkan tenant lain.
    function isOwnLocationChannel(scope) {
      return !scope.matches('location:.*') ||
        isSuperAdmin() ||
        scope == 'location:' + request.auth.token.tenantId;
    }

    match /admins/{scope}/events/{eventId} {
      allow read: if canAccessAdminPanel() && isOwnLocationChannel(scope);
      allow write: if false;
    }

    // Event work order dan tiket dulu hanya boleh dibaca pemegang akses panel
    // admin. Akibatnya teknisi yang DITUGASKAN ke sebuah work order tidak pernah
    // bisa mendengar event-nya: klaimnya `accessAdminPanel: false`, jadi
    // langganannya selalu `permission-denied` dan layar detail diam-diam
    // berhenti hidup. Gejalanya di lapangan: status berubah di satu perangkat
    // tapi perangkat lain tidak ikut berubah sampai ditarik-segarkan.
    //
    // Aturan tidak bisa menanyakan Postgres siapa yang ditugaskan, dan jalur
    // dokumen hanya memuat id work order. Sumbu yang tersedia adalah `tenantId`
    // yang kini ikut ditulis pada setiap envelope. Membuka tanpa syarat itu
    // berarti siapa pun yang menebak id work order bisa menyadap tenant lain.
    // `tenantId` null dipakai event worker latar yang memang tidak punya
    // konteks tenant; itu bukan kecocokan, melainkan ketiadaan jawaban.
    // Pelanggan dikecualikan: tenant yang sama tidak membuat tiket atau work
    // order pelanggan lain menjadi miliknya.
    function seTenant() {
      return !isCustomer() &&
        resource.data.tenantId != null &&
        isInTenant(resource.data.tenantId);
    }

    match /workorders/{woId}/events/{eventId} {
      allow read: if canAccessAdminPanel() || seTenant();
      allow write: if false;
    }

    match /tickets/{ticketId}/events/{eventId} {
      allow read: if canAccessAdminPanel() || seTenant();
      allow write: if false;
    }

    // Department events — mobile subscribe via subscribeToScope({kind:'department'}).
    // Tanpa rule ini, listener mobile dapat permission-denied dan event silent loss.
    match /departments/{departmentId}/events/{eventId} {
      allow read: if isSignedIn() && !isCustomer() && (
        isSuperAdmin() ||
        request.auth.token.departmentId == departmentId ||
        canAccessAdminPanel()
      );
      allow write: if false;
    }

    // Presence system untuk realtime online status
    match /presence/{userId} {
      // User bisa read/write presence mereka sendiri
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      // Pengguna lain yang masuk bisa read presence orang lain, kecuali
      // pelanggan: status daring staf bukan urusannya.
      allow read: if isSignedIn() && !isCustomer();
    }

    // Default deny semua collection lain (chat dll harus dideclarasi
    // eksplisit kalau diperlukan — saat ini chat masih REST-bound).
  }
}
