pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: node
    image: node:22-bookworm-slim
    command:
    - cat
    tty: true
'''
        }
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    triggers {
        githubPush()
        // Fallback: scan branch tiap 5 menit kalau webhook gagal trigger.
        pollSCM('H/5 * * * *')
    }

    parameters {
        booleanParam(
            name: 'ALLOW_NATIVE',
            defaultValue: false,
            description: 'Override stage "Detect Native Change". Centang HANYA setelah build APK baru sudah didistribusikan ke Play Store / sideload — kalau tidak, OTA akan crash di app lama yang belum punya native module baru.'
        )
        string(
            name: 'RELEASE_NOTES',
            defaultValue: '',
            description: 'Catatan rilis untuk update. Kosongkan untuk pakai default "OTA from CI build #N".'
        )
    }

    environment {
        BRANCH = "${env.GIT_BRANCH ?: env.BRANCH_NAME ?: 'unknown'}"
    }

    stages {
        stage('Detect Channel') {
            steps {
                script {
                    def branch = env.BRANCH.replaceAll(/^origin\//, '')
                    if (branch == 'main') {
                        env.CHANNEL = 'production'
                        env.BASE_URL = 'https://radpro.id'
                        env.EXPO_VARIANT = 'production'
                    } else if (branch == 'staging') {
                        env.CHANNEL = 'staging'
                        env.BASE_URL = 'https://staging.radpro.id'
                        env.EXPO_VARIANT = 'staging'
                    } else {
                        error "Branch '${branch}' tidak di-allowlist publish OTA. Hanya 'staging' dan 'main'."
                    }
                    echo "→ Channel: ${env.CHANNEL}"
                    echo "→ Base URL: ${env.BASE_URL}"
                }
            }
        }

        stage('Detect Native Change') {
            steps {
                container('node') {
                    sh """
                        set -e
                        BASE_REF="\${GIT_PREVIOUS_SUCCESSFUL_COMMIT:-HEAD~1}"
                        echo "Diffing vs \${BASE_REF}..."

                        NATIVE_CHANGED=0
                        if git diff --name-only "\${BASE_REF}" HEAD 2>/dev/null | grep -E '^(android/|ios/|app\\\\.config\\\\.ts|package\\\\.json)' >/tmp/native-diff.txt; then
                            cat /tmp/native-diff.txt
                            NATIVE_CHANGED=1
                        fi

                        if [ "\$NATIVE_CHANGED" = "1" ] && [ "${params.ALLOW_NATIVE}" != "true" ]; then
                            echo ""
                            echo "❌ Detected native-level change. OTA tidak boleh untuk perubahan native."
                            echo "   Rilis APK baru via build_apk.sh, atau centang ALLOW_NATIVE saat build."
                            exit 1
                        fi

                        if [ "\$NATIVE_CHANGED" = "1" ]; then
                            echo "⚠️  Native change detected, ALLOW_NATIVE=true → continuing."
                        else
                            echo "✓ No native change detected."
                        fi
                    """
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                container('node') {
                    sh '''
                        set -e
                        if ! command -v curl >/dev/null 2>&1; then
                            apt-get update -qq && apt-get install -y -qq curl ca-certificates >/dev/null
                        fi
                        npm ci --no-audit --no-fund
                    '''
                }
            }
        }

        stage('Build & Publish') {
            steps {
                container('node') {
                    withCredentials([
                        string(credentialsId: 'app-update-publish-token', variable: 'APP_UPDATE_PUBLISH_TOKEN')
                    ]) {
                        script {
                            def notes = params.RELEASE_NOTES?.trim() ?: "OTA from CI build #${env.BUILD_NUMBER}"
                            sh """
                                set -e
                                chmod +x ./scripts/publish-update.sh
                                ./scripts/publish-update.sh "\${CHANNEL}" ${groovy.json.JsonOutput.toJson(notes)}
                            """
                        }
                    }
                }
            }
        }

        stage('Verify Manifest') {
            steps {
                container('node') {
                    sh '''
                        set -e
                        # runtimeVersion = fingerprint EAS build FINISHED (match APK Play Store)
                        RUNTIME=$(node ./scripts/get-eas-fingerprint.js android)
                        echo "Verifying ${BASE_URL}/api/mobile/app-update/manifest (runtime=${RUNTIME}, channel=${CHANNEL})..."
                        STATUS=$(curl -sS -o /tmp/manifest.json -w "%{http_code}" \
                            -H "expo-runtime-version: ${RUNTIME}" \
                            -H "expo-platform: android" \
                            -H "expo-channel-name: ${CHANNEL}" \
                            -H "expo-protocol-version: 1" \
                            "${BASE_URL}/api/mobile/app-update/manifest")
                        if [ "$STATUS" = "204" ]; then
                            echo "❌ Manifest 204 (no update) — fingerprint ${RUNTIME} tidak ditemukan di server. Publish mungkin pakai runtimeVersion salah."
                            exit 1
                        fi
                        if [ "$STATUS" != "200" ]; then
                            echo "❌ Manifest endpoint return ${STATUS}"
                            cat /tmp/manifest.json || true
                            exit 1
                        fi
                        echo "✓ Manifest OK (fingerprint match APK di Play Store)"
                        head -c 500 /tmp/manifest.json && echo "..."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ OTA published to ${env.CHANNEL} (${env.BASE_URL})"
        }
        failure {
            echo "❌ OTA publish failed for branch ${env.BRANCH}"
        }
    }
}
